# Vercel Environment Variables — copy to Vercel → Settings → Environment Variables
# Generate BANK_API_KEY: openssl rand -hex 32  (or any long random string)

# ── Required for cross-device sync ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── API security (strongly recommended in production) ──
# Same value must be entered once in the app: Settings → אבטחה → מפתח API
BANK_API_KEY=

# ── Email (choose SMTP or Resend) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Or:
# RESEND_API_KEY=
# EMAIL_FROM=orders@your-domain.com

# ── AI product/receipt parsing (optional) ──
ANTHROPIC_API_KEY=

# ── Web Push notifications (optional) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Cron protection (recommended) ──
CRON_SECRET=

# ── Priority ERP (optional — configure when ready) ──
PRIORITY_SERVICE_ROOT=
PRIORITY_API_USER=
PRIORITY_API_PASS=
